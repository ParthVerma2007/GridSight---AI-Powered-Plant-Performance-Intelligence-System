# Environment Configuration for Plant Performance Intelligence System
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database configuration (SQLite for local, easily switchable to PostgreSQL)
DATABASE_URL=sqlite:///./plant_data.db

# AI Provider Configuration
# Supported options: 'gemini', 'huggingface', 'fallback'
AI_PROVIDER=fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Plant Location Settings (Helios-50 Solar Farm default: Southern California desert)
PLANT_DEFAULT_LATITUDE=34.0522
PLANT_DEFAULT_LONGITUDE=-117.2437
PLANT_TIMEZONE=America/Los_Angeles

# Open-Meteo Cache Expiry in seconds
WEATHER_CACHE_TTL_SECONDS=3600
